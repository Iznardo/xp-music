{
  "name": "xp-music",
  "version": "1.0.0",
  "private": true,
  "description": "Reproductor de YouTube Music con estÃƒÂ©tica Windows Media Player / XP",
  "author": "iznardo",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "tauri": "tauri",
    "gen:bindings": "cargo test --manifest-path src-tauri/Cargo.toml --lib export_bindings",
    "check:front": "svelte-check --tsconfig ./tsconfig.json",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run check:front && npm run check:rust",
    "fetch-tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-tools.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
